ADMIN_USER=admin
# Hash scrypt: salt hexadecimal seguido de : y hash de 64 bytes hexadecimal.
ADMIN_PASSWORD_HASH=
# Secreto aleatorio de al menos 32 caracteres, solo en el servidor.
ADMIN_SESSION_SECRET=

# Maintained student authentication. The publishable key is safe for the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only. NEVER add VITE_ to a secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TPPLAY_APP_ORIGIN=http://127.0.0.1:5173

# Solo herramientas locales de migración; nunca VITE_ ni incluir en el build
DATABASE_URL=
TPPLAY_APPLY_MIGRATIONS=false
# Solo seed en un proyecto Supabase separado de producción
TPPLAY_ALLOW_TEST_SEED=false
